# 로컬 개발용 환경변수 — 복사 후 .env.local로 저장

# 백엔드 URL (로컬에서 Koyeb 직접 호출)
NEXT_PUBLIC_API_URL=https://deliberate-lenette-coggiri-5ee7b85e.koyeb.app

# 카카오 OAuth (카카오 개발자 콘솔에서 복사)
# Web 플랫폼에 http://localhost:3000 추가 필요
# Redirect URI에 http://localhost:3000/auth/kakao/callback 추가 필요
NEXT_PUBLIC_KAKAO_CLIENT_ID=<카카오_REST_API_키>
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 로컬에서는 카카오 로그인 대신 관리자 로그인 사용 가능:
#   http://localhost:3000/auth/admin-login
#   (ID/PW는 Koyeb 환경변수 DASHBOARD_ADMIN_USERNAME/PASSWORD 기준)

# 슬랙 알림 (Astro 데이터 변화 → #sat-astro-세일즈)
# 배포 알림과 같은 봇 토큰이다. Vercel 환경변수에도 같은 이름으로 넣어야 운영에서 알림이 간다.
# 없으면 알림만 조용히 빠지고 툴 동작에는 영향이 없다.
SLACK_BOT_TOKEN=xoxb-...
# 봇을 못 쓸 때의 우회로 (Incoming Webhook)
# SLACK_ASTRO_WEBHOOK_URL=https://hooks.slack.com/services/...

# Probe 앱 지표 — GA4 원본(BigQuery) 4칸. 없으면 해당 칸은 "연결 전" 으로 남는다.
# wouldulike-efe19 의 서비스 계정 키(JSON 원문 또는 base64). 권한: BigQuery 작업 사용자(프로젝트) + 데이터 뷰어(analytics_494806625 데이터셋만).
# Vercel 환경변수에도 같은 이름으로 넣는다. 절대 커밋하지 않는다.
# 확인: node --no-warnings --env-file=.env.local scripts/probe-bq-check.mts
GCP_SA_KEY=
# BQ_DATASET=wouldulike-efe19.analytics_494806625

# ── 점주 온보딩 (lib/onboard) ─────────────────────────────────────────────
# 링크 토큰 서명키. 32자 이상 무작위. 운영에 없으면 발급 자체가 막힌다. (openssl rand -base64 32)
ONBOARD_SECRET=
# 동의 기록 사본 ① 구글 시트 — 비서 config/.env 의 GSHEET_URL/GSHEET_TOKEN 과 같은 Web App. 탭은 없으면 만들어 둔다.
ONBOARD_GSHEET_URL=
ONBOARD_GSHEET_TOKEN=
ONBOARD_GSHEET_ID=16iayAaXC33xm2xQnWHBQ-grpNI2SL8-vm968bZtcu-s
ONBOARD_GSHEET_TAB=온보딩기록
# 동의 기록 사본 ② 드라이브 — 자료실_업로드.gs 와 같은 Web App (DRIVE_URL/DRIVE_TOKEN)
ONBOARD_DRIVE_URL=
ONBOARD_DRIVE_TOKEN=
# 휴대폰 SMS 인증 제공자. 비우면 인증 단계는 "번호 입력만" 으로 돌아가고 phone_verified=false 로 기록된다.
# ONBOARD_SMS_PROVIDER=solapi
# 완료 화면에서 내려주는 점주 안내문 링크(드라이브 등). 없으면 링크 칸이 숨는다.
# ONBOARD_GUIDE_URL=
