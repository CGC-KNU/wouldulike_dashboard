# 백엔드 API URL
NEXT_PUBLIC_API_URL=https://your-backend.koyeb.app

# 카카오 로그인
NEXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_client_id
# NEXT_PUBLIC_KAKAO_REDIRECT_URI — 더 이상 읽지 않는다 (0923).
# 값이 vercel.app 으로 고정돼 있어서 app.wouldulike.kr 에서 로그인하면 카카오가 다른 도메인으로
# 돌려보냈고, 세션 쿠키가 거기 남아 슬랙 딥링크가 전부 첫 화면으로 떨어졌다.
# 이제 코드가 지금 열린 origin 을 쓴다. 카카오 콘솔에 Redirect URI 를 도메인마다 등록하면 된다.

# Apple 로그인
NEXT_PUBLIC_APPLE_CLIENT_ID=com.coggiri.wouldulike0117
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# 앱 → 웹 자동로그인 시크릿 (백엔드와 공유)
APP_WEBVIEW_SECRET=your_secret_key

# 대시보드 자체 URL — 슬랙 알림의 "대시보드에서 보기" 딥링크 생성에 사용
NEXT_PUBLIC_SITE_URL=https://your-dashboard.vercel.app

# 슬랙 Incoming Webhook — 콘텐츠 피드백(댓글) 등록 시 알림 발송
SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Drive 매장 QR 이 가리킬 웹 스탬프 주소(wouldulike_experience). 예: https://stamp.example.com
NEXT_PUBLIC_STAMP_WEB_BASE=
# 웹 스탬프 QR 로 바뀌는 시각(선택). 비우면 2026-12-01 00:00 KST. 그 전에는 기존 앱 흐름 주소.
# NEXT_PUBLIC_STAMP_WEB_START=2026-12-01T00:00:00+09:00
